# ── AI ────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Security (generate both with the commands below) ──────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_here

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insurbridge
# Or override the whole URI (useful for Neon/cloud):
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:pass@host/db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Startup behaviour ─────────────────────────────────────────────────────────
# The database schema is managed by Alembic (`alembic upgrade head` — the
# docker-compose backend service runs it automatically). AUTO_CREATE_TABLES is
# only a legacy fallback; keep it false unless debugging.
AUTO_CREATE_TABLES=false
AUTO_SEED_DATA=true
# Password assigned to seeded demo users (a random one is generated and logged
# at startup when unset):
# SEED_DEMO_PASSWORD=change-me-before-any-real-use

# ── Runtime environment ───────────────────────────────────────────────────────
# "development" allows localhost CORS origins; "production" requires CORS_ORIGINS.
ENVIRONMENT=development

# ── Dev / debug ───────────────────────────────────────────────────────────────
SQL_ECHO=false
EXPOSE_ERROR_DETAILS=false

# ── CORS (only needed when frontends are on different origins) ─────────────────
# CORS_ORIGINS=https://your-d2c.vercel.app,https://your-portal.vercel.app
